  "LangGeneral.mc_sed_textConfigEditStyle.text": "The selected style can be configured from the \"Character\" and \"Item / Object\" tabs.\nIf you create multiple styles, you can cycle through them in order with the #1 key.",
  "LangGeneral.mc_sed_thing.text": "Item / Object",
  "LangGeneral.mc_sed_thingExtraInformation.text": "Extra Information",
  "LangGeneral.mc_sed_thingName.text": "Item / Object Name",
  "LangGeneral.mc_sed_tooltipActParty.text": "Allows you to distinguish abilities that have both single-target and area-of-effect versions.\nFor area-of-effect abilities, (pt) is appended to the ability name.",
  "LangGeneral.mc_sed_tooltipAddStyle.text": "Adds a new style.\nYou can configure up to #1 styles.",
  "LangGeneral.mc_sed_tooltipCharaType.text": "Displays the character type.\nBoss: [BOSS]\nUnique: ★\nElite: ☆",
  "LangGeneral.mc_sed_tooltipDeleteStyle.text": "Deletes the selected style.\nYou cannot have fewer than #1 styles.",
  "LangGeneral.mc_sed_tooltipDisableMimicry.text": "Displays the true information even if the target is mimicking or personified.\nWhen disabled, false information is displayed.\nDepending on the displayed item, you may be able to see through the deception.",
  "LangGeneral.mc_sed_tooltipDisableShadowform.text": "Displays the correct name even if the target is in Shadowform.\nWhen disabled, a false name is displayed.",
  "LangGeneral.mc_sed_tooltipDisplayNoneResistLevel.text": "Displays all resistances, including those with a level of None.",
  "LangGeneral.mc_sed_tooltipDisplayUnidentifiedItemsAsIdentified.text": "Displays the same information for unidentified items as for identified items.",
  "LangGeneral.mc_sed_tooltipFactionMemberType.text": "Displays the member type at the base.\nExamples include (Guest) and (Livestock).",
  "LangGeneral.mc_sed_tooltipFeatValue.text": "Displays feat levels.\nLevel 1 is not displayed for better readability.",
  "LangGeneral.mc_sed_tooltipFressness.text": "Displays freshness.\nThe freshest items are shown as 100%, while rotten items are shown as 0%.",
  "LangGeneral.mc_sed_tooltipGroupResistByLevel.text": "Groups resistances by level (Immunity, Superb, …).",
  "LangGeneral.mc_sed_tooltipMainColor.text": "The display color used for information without an individual color setting.",
  "LangGeneral.mc_sed_tooltipMoveStyleBackward.text": "Moves the selected style one position backward (or to the end if it is first).\nReordering styles changes the order in which they are cycled.",
  "LangGeneral.mc_sed_tooltipMoveStyleForward.text": "Moves the selected style one position forward (or to the beginning if it is last).\nReordering styles changes the order in which they are cycled.",
  "LangGeneral.mc_sed_tooltipPickPreviewChara.text": "Randomly updates the character shown in the preview.\nThe target is selected from party members (or the PC if there are none).",
  "LangGeneral.mc_sed_tooltipPickPreviewThing.text": "Randomly updates the item / object shown in the preview.\nThe target is selected from those present on the map.",
  "LangGeneral.mc_sed_tooltipRenameStyle.text": "Renames the selected style.\nGiving styles names makes them easier to identify in the settings screen.",
  "LangGeneral.mc_sed_tooltipSubColor.text": "The display color used for secondary information such as primary attributes and feats.",
  "LangGeneral.mc_sed_tooltipUseAnimation.text": "Enables animations.\nDisable this if performance is poor or if you do not need them.",
  "LangGeneral.mc_sed_tooltipSplitManaBodyHealthBar.text": "Displays HP- and MP-based durability in different colors on the health bars of characters with Mana Body.",
  "LangGeneral.mc_sed_tooltipUseRarityColor.text": "Changes the name text color based on rarity.",
  "LangGeneral.mc_sed_tooltipUseShortResistLavelLabel.text": "Uses shorter labels for resistance levels.\nImmunity is shown as +20, Superb as +15, and so on.",
